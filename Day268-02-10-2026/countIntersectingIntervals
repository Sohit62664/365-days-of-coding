class Solution {
    public int countIntersectingIntervals(int[][] intervals) {
        int n = intervals.length;
        int count =0 ; 
        Arrays.sort(intervals , (a,b)-> Integer.compare(a[0],b[0]));
        for(int i =0 ; i< n  ; i++){
            for(int j= i+1 ; j< n  ; j++){
                int end= intervals[i][1];
                int st = intervals[j][0];
                if(end >= st){
                    count++;
                }
                
            }
        }

        return count ; 
    }
}

