class Solution {
    public int longestSubarray(int[] nums, int k) {
        // logic findout all the subarray , for each take sum and get modulo if modulo == 0 trak max length otherwise findout the remainder in the subarry 
        // brute force will take around o(n^3);
        // subarraty sum equals k
        // Brute force app 
        // calculate subarray sum , for each elpment *2 is divisible by k 
        // then track the max length 

        int prefix[] = new int[nums.length];
        prefix[0] = nums[0];

        for (int i = 1; i < nums.length; i++) {
            prefix[i] = prefix[i - 1] + nums[i];
        }

        // Query sum 
        // sum from i to j 
        int max_len = 0;
        for (int i = 0; i < nums.length; i++) {
            for (int j = i; j < nums.length; j++) {
                int sum = 0;
                if (i != 0)
                    sum = prefix[j] - prefix[i - 1];
                else {
                    sum = prefix[j];
                }
                if (sum % k == 0) {
                    max_len = Math.max(j - i + 1, max_len);
                    continue;
                }

                for (int l = i; l <= j; l++) {
                    int newsum = sum - nums[l] * 2;
                    if (newsum % k == 0) {
                        max_len = Math.max(j - i + 1, max_len);
                    }

                }
            }
        }

        return max_len;

    }
}
