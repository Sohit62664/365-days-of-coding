class Solution {
    public int longestCommonSubsequence(String text1, String text2) {
        char[] s1 =  text1.toCharArray();
        char[] s2 =  text2.toCharArray();

        int n = s1.length;
        int m = s2.length;

        int [][] dp = new int [n+1][m+1];

        for(int i = 1; i <= n; i++){
            for(int j = 1; j <= m; j++){

                if(s1[i-1] == s2[j-1])
                    dp[i][j] = 1 + dp[i-1][j-1];

                else
                    dp[i][j] = Math.max(dp[i-1][j], dp[i][j-1]);
            }
        }

        return dp[n][m];

    }
}
