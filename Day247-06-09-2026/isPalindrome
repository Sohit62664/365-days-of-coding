class Solution {
    
    public boolean isPalindrome(String s) {
        StringBuilder sb= new StringBuilder();
        alphanumeric(s , sb);
        int i =0 ; 

        int j = sb.length() -1;


        while(i<=j){
            if(sb.charAt(i)!= sb.charAt(j)){
                return false;
            }
            i++;
            j--;
        }
        System.out.println(sb.toString());
        return true;
    }

    void alphanumeric(String s , StringBuilder sb){
        for(int i = 0 ; i< s.length() ; i++){
            char ch = s.charAt(i);

            if(ch >= '0' && ch<='9'){
                sb.append(ch);
            }else if(ch>= 'A' && ch <='Z'){
                sb.append( (char) (ch+32));
            }else if(ch>= 'a' && ch <= 'z'){
                sb.append(ch);
            }
        }
    }
}
